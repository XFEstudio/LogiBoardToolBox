<UserControl x:Class="LogiBoardToolBox.Controls.DpiProfileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:LogiBoardToolBox.ViewModels" xmlns:local="using:LogiBoardToolBox.Controls">
 <UserControl.Resources><SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White"/><SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White"/><SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="White"/>
  <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#152436"/>
  <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#152436"/>
  <Style x:Key="ToolButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="4"/><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="DpiInput" TargetType="TextBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#444444"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="12,8"/></Style>
  <Style x:Key="RateCombo" TargetType="ComboBox"><Setter Property="Background" Value="Black"/><Setter Property="BorderBrush" Value="#444444"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="MinHeight" Value="38"/><Setter Property="Width" Value="208"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </UserControl.Resources>
 <Grid Padding="0,12,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#212224" CornerRadius="10" Padding="20,12,20,16"><Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="灵敏度" FontSize="20" FontWeight="Bold"/>
   <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Style="{StaticResource ToolButton}" ToolTipService.ToolTip="搜索预设" Click="SearchPresets_Click" AutomationProperties.Name="搜索预设"><PathIcon Style="{StaticResource AppVectorIcon}" Data="F0 M 8,1 A 7,7 0 1 1 7.99,15 A 7,7 0 0 1 8,1 Z M 8,2.5 A 5.5,5.5 0 1 0 8.01,13.5 A 5.5,5.5 0 0 0 8,2.5 Z M 13.2,12.2 L 19.1,18.1 L 18,19.2 L 12.1,13.3 Z"/></Button><Button Style="{StaticResource ToolButton}" ToolTipService.ToolTip="恢复配置值" Command="{x:Bind ViewModel.ResetPerformanceCommand}" AutomationProperties.Name="恢复配置值"><PathIcon Style="{StaticResource AppVectorIcon}" Data="M 2,2 H 3.5 V 6.2 A 8.3,8.3 0 1 1 1.8,13.9 L 3.2,13.4 A 6.8,6.8 0 1 0 4.8,7.3 H 8 V 8.8 H 2 Z"/></Button><Button Style="{StaticResource ToolButton}" Content="+" FontSize="24" ToolTipService.ToolTip="新建灵敏度预设" Click="AddPreset_Click"/></StackPanel>
   <Border Grid.Row="2" Background="#353638"/>
   <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="10" Padding="0,12,0,0"><TextBox x:Name="PresetSearch" Visibility="Collapsed" PlaceholderText="搜索预设" TextChanged="PresetSearch_Changed"/><Grid><TextBlock Text="精选预设" FontSize="13"/><TextBlock Text="⌃" HorizontalAlignment="Right"/></Grid>
    <ListView x:Name="PresetList" ItemsSource="{x:Bind ViewModel.DpiPresets}" IsItemClickEnabled="True" ItemClick="Preset_Click" SelectionMode="None"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,4"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="vm:EditorChoice"><TextBlock Text="{x:Bind Label}" FontSize="13"/></DataTemplate></ListView.ItemTemplate></ListView>
    <Grid Margin="0,12,0,0"><TextBlock Text="自定义预设" FontSize="13"/><TextBlock Text="⌃" HorizontalAlignment="Right"/></Grid>
    <ListView x:Name="CustomPresets" IsItemClickEnabled="True" ItemClick="CustomPreset_Click" SelectionMode="None"><ListView.ItemTemplate><DataTemplate x:DataType="vm:SensitivityPreset"><TextBlock Text="{x:Bind Name}" FontSize="13" Foreground="#00A8F3"/></DataTemplate></ListView.ItemTemplate></ListView>
   </StackPanel></ScrollViewer>
  </Grid></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><Grid Margin="88,0,34,20"><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="{x:Bind ViewModel.SensitivityName, Mode=OneWay}" FontSize="18" FontWeight="Bold" Margin="16,10,0,0"/>
   <Grid Grid.Row="1"><StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0"><Button Style="{StaticResource ToolButton}" ToolTipService.ToolTip="重命名" Click="RenamePreset_Click" AutomationProperties.Name="重命名"><PathIcon Style="{StaticResource AppVectorIcon}" Data="F0 M 13.9,1.6 Q 15.6,-.1 17.2,1.6 L 18.4,2.8 Q 20.1,4.4 18.4,6.1 L 7.1,17.4 L 1.1,18.9 L 2.6,12.9 Z M 15,2.7 L 13.6,4.1 L 15.9,6.4 L 17.3,5 Q 18,4.4 17.3,3.8 L 16.2,2.7 Q 15.6,2.1 15,2.7 Z M 12.5,5.2 L 4,13.7 L 3.2,16.8 L 6.3,16 L 14.8,7.5 Z"/></Button><Button Style="{StaticResource ToolButton}" ToolTipService.ToolTip="恢复配置值" Command="{x:Bind ViewModel.ResetPerformanceCommand}" AutomationProperties.Name="恢复配置值"><PathIcon Style="{StaticResource AppVectorIcon}" Data="M 2,2 H 3.5 V 6.2 A 8.3,8.3 0 1 1 1.8,13.9 L 3.2,13.4 A 6.8,6.8 0 1 0 4.8,7.3 H 8 V 8.8 H 2 Z"/></Button><Button Style="{StaticResource ToolButton}" ToolTipService.ToolTip="复制预设" Click="AddPreset_Click" AutomationProperties.Name="复制预设"><PathIcon Style="{StaticResource AppVectorIcon}" Data="F0 M 6,1 H 18 V 15 H 6 Z M 7.5,2.5 V 13.5 H 16.5 V 2.5 Z M 2,5 H 4.5 V 6.5 H 3.5 V 17.5 H 12.5 V 16.5 H 14 V 19 H 2 Z"/></Button><Button Style="{StaticResource ToolButton}" ToolTipService.ToolTip="删除自定义预设" Click="DeletePreset_Click" AutomationProperties.Name="删除自定义预设"><PathIcon Style="{StaticResource AppVectorIcon}" Data="F0 M 2,4 H 7 V 2 H 13 V 4 H 18 V 5.5 H 2 Z M 8.4,3 V 4 H 11.6 V 3 Z M 3.5,6.5 H 16.5 L 15.3,19 H 4.7 Z M 5.1,8 L 6.1,17.5 H 13.9 L 14.9,8 Z M 8,9 H 9.3 V 16 H 8 Z M 10.7,9 H 12 V 16 H 10.7 Z"/></Button></StackPanel><CheckBox Content="高级" FontSize="12" IsChecked="{x:Bind ViewModel.AdvancedDpi, Mode=TwoWay}" HorizontalAlignment="Right"/></Grid>
   <Border Grid.Row="2" Background="#242424" Height="1" VerticalAlignment="Bottom"/>
   <Grid Grid.Row="3" ColumnSpacing="84"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
    <StackPanel><Grid Height="56" Padding="14,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="64"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><TextBlock Text="档位" FontSize="13" Foreground="#999999" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="DPI" FontSize="13" Foreground="#999999" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="Y 轴" Width="115" Visibility="{x:Bind ViewModel.AdvancedDpi, Mode=OneWay}" FontSize="13" Foreground="#999999" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="已启用" FontSize="13" Foreground="#999999" VerticalAlignment="Center"/></Grid>
     <ListView ItemsSource="{x:Bind ViewModel.DpiStages}" SelectedItem="{x:Bind ViewModel.SelectedDpiStage, Mode=TwoWay}" IsItemClickEnabled="True" ItemClick="Stage_Click" SelectionMode="Single" HorizontalContentAlignment="Stretch"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="52"/><Setter Property="CornerRadius" Value="6"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate x:DataType="vm:DpiStageEditor"><Grid Height="52" ColumnSpacing="10" Padding="14,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="47"/><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="54"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
       <Grid><Border Width="3" Height="38" Background="#00A9E0" CornerRadius="1.5" HorizontalAlignment="Left" Visibility="{x:Bind IsCurrent, Mode=OneWay}"/><StackPanel VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="{x:Bind Slot}" FontSize="13"/><TextBlock Text="当前" Foreground="#65C9FF" FontSize="10" Visibility="{x:Bind IsCurrent, Mode=OneWay}"/></StackPanel></Grid>
       <local:PrecisionSlider Grid.Column="1" Tag="{x:Bind}" Minimum="{x:Bind Minimum, Mode=OneWay}" Maximum="{x:Bind Maximum, Mode=OneWay}" Value="{x:Bind NumericValue, Mode=OneWay}" ValueChanged="DpiSlider_Changed" IsEnabled="{x:Bind Enabled, Mode=OneWay}" VerticalAlignment="Center" StepFrequency="1"/>
       <local:CommitTextBox Grid.Column="2" Tag="{x:Bind}" AutomationProperties.AutomationId="stage-dpi-x" Value="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DpiInput}" Validating="DpiValue_Validating" ValueCommitted="DpiValue_Committed" DraftEdited="DpiValue_DraftEdited"/>
       <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Visibility="{x:Bind IsAdvanced, Mode=OneWay}"><ToggleButton IsChecked="{x:Bind LinkAxes, Mode=TwoWay}" Width="25" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="联动 X/Y 轴" AutomationProperties.Name="联动 X/Y 轴"><PathIcon Style="{StaticResource AppVectorIcon}" Data="M 11,4 L 13.2,1.8 A 3.6,3.6 0 1 1 18.2,6.9 L 14.7,10.4 Q 12.6,12.5 10.2,10.9 L 11.3,9.8 Q 12.6,10.4 13.6,9.3 L 17.1,5.8 A 2.1,2.1 0 1 0 14.2,2.9 L 12,5.1 Z M 9,16 L 6.8,18.2 A 3.6,3.6 0 1 1 1.8,13.1 L 5.3,9.6 Q 7.4,7.5 9.8,9.1 L 8.7,10.2 Q 7.4,9.6 6.4,10.7 L 2.9,14.2 A 2.1,2.1 0 1 0 5.8,17.1 L 8,14.9 Z M 6.9,12 L 12,6.9 L 13.1,8 L 8,13.1 Z"/></ToggleButton><local:CommitTextBox Width="84" Tag="{x:Bind}" AutomationProperties.AutomationId="stage-dpi-y" Value="{x:Bind ValueY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind SeparateAxes, Mode=OneWay}" Style="{StaticResource DpiInput}" Validating="DpiValue_Validating" ValueCommitted="DpiValue_Committed" DraftEdited="DpiValue_DraftEdited"/></StackPanel>
       <ToggleSwitch Grid.Column="4" IsOn="{x:Bind Enabled, Mode=TwoWay}" MinWidth="0" Width="44" OnContent="" OffContent="" VerticalAlignment="Center"/>
       <Button Grid.Column="5" Content="⋮" FontSize="21" Background="Transparent" BorderThickness="0" Padding="0" Width="22"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="设为默认 DPI" Tag="default" CommandParameter="{x:Bind}" Click="StageAction_Click"/><MenuFlyoutItem Text="设为 DPI Shift" Tag="shift" CommandParameter="{x:Bind}" Click="StageAction_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="停用此档位" Tag="disable" CommandParameter="{x:Bind}" Click="StageAction_Click"/></MenuFlyout></Button.Flyout></Button>
      </Grid></DataTemplate></ListView.ItemTemplate>
     </ListView>
    </StackPanel>
    <StackPanel Grid.Column="1" Spacing="16" Padding="0,40,0,0"><StackPanel Spacing="10"><TextBlock Text="无线回报率" FontSize="14"/><ComboBox Style="{StaticResource RateCombo}" ItemsSource="{x:Bind ViewModel.WirelessReportRates}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.SelectedWirelessRate, Mode=TwoWay}" DropDownClosed="WirelessRate_Closed"/></StackPanel><StackPanel Spacing="10"><TextBlock Text="有线回报率" FontSize="14"/><ComboBox Style="{StaticResource RateCombo}" ItemsSource="{x:Bind ViewModel.ReportRates}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.SelectedRate, Mode=TwoWay}"/></StackPanel>
     <StackPanel Spacing="10" Margin="0,12,0,0" Visibility="{x:Bind ViewModel.HasHeroCalibration, Mode=OneWay}"><TextBlock Text="HERO 传感器校准" FontSize="14"/><ComboBox x:Name="HeroSelector" AutomationProperties.AutomationId="hero-selector" ItemsSource="{x:Bind ViewModel.HeroChoices}" DisplayMemberPath="Label" SelectedIndex="0" Style="{StaticResource RateCombo}" SelectionChanged="Hero_Changed" IsEnabled="{x:Bind ViewModel.IsEditingSoftware, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.HeroCalibrationStatus, Mode=OneWay}" MaxWidth="260" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/></StackPanel><HyperlinkButton Content="↗ 打开 WINDOWS 鼠标设置" FontSize="12" Padding="0" Margin="0,14,0,0" Click="WindowsMouse_Click"/><TextBlock Text="{x:Bind ViewModel.PerformanceSummary, Mode=OneWay}" MaxWidth="260" TextWrapping="Wrap" FontSize="11" Foreground="#888888"/><Button Content="打开板载配置" Visibility="{x:Bind ViewModel.IsEditingSoftware, Mode=OneWay}" FontSize="12" Background="Transparent" BorderBrush="#444444" Click="StageProfile_Click"/>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Row="4" Spacing="8" Margin="14,16,0,0"><TextBlock Text="{x:Bind ViewModel.DpiInputError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasDpiInputError, Mode=OneWay}" Foreground="#F08080" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.PerformanceNote, Mode=OneWay}" Visibility="{x:Bind ViewModel.AdvancedDpi, Mode=OneWay}" FontSize="12" Foreground="#888888" TextWrapping="Wrap"/></StackPanel>
  </Grid></ScrollViewer>
 </Grid>
</UserControl>
