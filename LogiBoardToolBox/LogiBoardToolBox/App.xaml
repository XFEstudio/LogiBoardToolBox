<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="LogiBoardToolBox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LogiBoardToolBox">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="/Styles/Thickness.xaml" />
                <ResourceDictionary Source="/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Styles/ConverterResources.xaml" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#009EFF</Color>
            <Color x:Key="SystemAccentColorLight1">#00A9F4</Color>
            <Color x:Key="SystemAccentColorLight2">#40BAFF</Color>
            <Color x:Key="SystemAccentColorLight3">#70CAFF</Color>
            <Color x:Key="SystemAccentColorDark1">#0091E8</Color>
            <Color x:Key="SystemAccentColorDark2">#007FC9</Color>
            <Color x:Key="SystemAccentColorDark3">#006BA8</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#009EFF"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#009EFF"/>
            <Style TargetType="CheckBox">
                <Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="26"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="CheckSurface" Width="12" Height="12" BorderBrush="#888888" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"/><Path x:Name="CheckMark" Data="M 2,6 L 5,9 L 10,2" Stroke="#222222" StrokeThickness="1.5" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/><ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CombinedStates"><VisualState x:Name="CheckedNormal"><VisualState.Setters><Setter Target="CheckSurface.Background" Value="#AAAAAA"/><Setter Target="CheckMark.Visibility" Value="Visible"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="CheckSurface.Background" Value="#AAAAAA"/><Setter Target="CheckMark.Visibility" Value="Visible"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="CheckSurface.Background" Value="#AAAAAA"/><Setter Target="CheckMark.Visibility" Value="Visible"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="CheckSurface.Background" Value="#AAAAAA"/><Setter Target="CheckMark.Visibility" Value="Visible"/></VisualState.Setters></VisualState><VisualState x:Name="UncheckedNormal"><VisualState.Setters><Setter Target="CheckSurface.Background" Value="Transparent"/><Setter Target="CheckMark.Visibility" Value="Collapsed"/></VisualState.Setters></VisualState><VisualState x:Name="UncheckedPointerOver"><VisualState.Setters><Setter Target="CheckSurface.Background" Value="Transparent"/><Setter Target="CheckMark.Visibility" Value="Collapsed"/></VisualState.Setters></VisualState><VisualState x:Name="UncheckedPressed"><VisualState.Setters><Setter Target="CheckSurface.Background" Value="Transparent"/><Setter Target="CheckMark.Visibility" Value="Collapsed"/></VisualState.Setters></VisualState><VisualState x:Name="UncheckedDisabled"><VisualState.Setters><Setter Target="CheckSurface.Background" Value="Transparent"/><Setter Target="CheckMark.Visibility" Value="Collapsed"/></VisualState.Setters></VisualState><VisualState x:Name="IndeterminateNormal"/></VisualStateGroup></VisualStateManager.VisualStateGroups></Grid></ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
