<Page x:Class="LogiBoardToolBox.Views.AppShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:add="using:XFEExtension.NetCore.WinUIHelper.Utilities.Additions" Loaded="Page_Loaded">
    <Grid Background="Black">
        <TitleBar x:Name="appTitleBar" Title="LogiBoardToolBox" Visibility="Collapsed"/>
        <NavigationView x:Name="navigationView" Visibility="Collapsed" IsSettingsVisible="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="鼠标" add:NavigationAddition.NavigateTo="LogiBoardToolBox.Views.MainPage"/>
                <NavigationViewItem Content="日志" add:NavigationAddition.NavigateTo="LogiBoardToolBox.Views.LogViewPage"/>
                <NavigationViewItem Content="设置" add:NavigationAddition.NavigateTo="LogiBoardToolBox.Views.SettingPage"/>
            </NavigationView.MenuItems>
        </NavigationView>
        <Grid x:Name="loadingGrid"><Frame x:Name="navigationFrame"/></Grid>
        <Grid x:Name="rightPanelGrid" Canvas.ZIndex="2" VerticalAlignment="Top" Margin="0,64,0,0">
            <StackPanel x:Name="messageStackPanel" HorizontalAlignment="Center"/>
        </Grid>
        <Grid x:Name="globalLoadingGrid" Canvas.ZIndex="3" Visibility="Collapsed" Background="#A0000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18"><TextBlock x:Name="globalLoadingTextBlock" Foreground="White" Text="加载中…"/><ProgressRing IsActive="True"/></StackPanel>
        </Grid>
    </Grid>
</Page>
