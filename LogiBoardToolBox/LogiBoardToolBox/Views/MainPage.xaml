<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="LogiBoardToolBox.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      RequestedTheme="Dark" Background="Black" FontFamily="/Assets/Fonts/BrownLogitechPan-Regular.otf#Brown Logitech Pan" xmlns:vm="using:LogiBoardToolBox.ViewModels" xmlns:board="using:LogiBoardToolBox.Core.Onboard" xmlns:mouse="using:LogiBoardToolBox.Controls" Loaded="Page_Loaded">
    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#00A8F3"/>
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#0096DC"/>
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#00A8F3"/>
        <Style x:Key="RailButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#999999"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="9"/>
        </Style>
        <Style x:Key="GHubViewButton" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="10"/><Setter Property="Height" Value="20"/><Setter Property="MinWidth" Value="40"/><Setter Property="Padding" Value="7,0"/><Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="Black"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="ViewBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12"><ContentPresenter x:Name="ViewContent" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Checked"><VisualState.Setters><Setter Target="ViewBorder.Background" Value="White"/><Setter Target="ViewContent.Foreground" Value="Black"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="ViewBorder.Background" Value="White"/><Setter Target="ViewContent.Foreground" Value="Black"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="ViewBorder.Background" Value="White"/><Setter Target="ViewContent.Foreground" Value="Black"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="ViewBorder.Background" Value="White"/><Setter Target="ViewContent.Foreground" Value="Black"/></VisualState.Setters></VisualState><VisualState x:Name="Normal"><VisualState.Setters><Setter Target="ViewBorder.Background" Value="Black"/><Setter Target="ViewContent.Foreground" Value="White"/></VisualState.Setters></VisualState><VisualState x:Name="PointerOver"/><VisualState x:Name="Pressed"/><VisualState x:Name="Disabled"/></VisualStateGroup></VisualStateManager.VisualStateGroups></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GHubShiftToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="16"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Grid Background="#555555" CornerRadius="8"><Ellipse x:Name="Thumb" Width="16" Height="16" HorizontalAlignment="Left" Fill="White"/><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Thumb.HorizontalAlignment" Value="Right"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Thumb.HorizontalAlignment" Value="Right"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Thumb.HorizontalAlignment" Value="Right"/></VisualState.Setters></VisualState><VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="Thumb.HorizontalAlignment" Value="Right"/></VisualState.Setters></VisualState><VisualState x:Name="Normal"><VisualState.Setters><Setter Target="Thumb.HorizontalAlignment" Value="Left"/></VisualState.Setters></VisualState><VisualState x:Name="PointerOver"/><VisualState x:Name="Pressed"/><VisualState x:Name="Disabled"/></VisualStateGroup></VisualStateManager.VisualStateGroups></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#888888"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent"><ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Height="1" Background="{TemplateBinding BorderBrush}" Width="16" VerticalAlignment="Bottom"/></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Page.Resources>
    <Grid x:Name="HostViewport" Background="Black" SizeChanged="HostViewport_SizeChanged"><Viewbox Stretch="Uniform"><Grid x:Name="DeviceSurface" Width="2048" Height="1114" Background="Black">
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="DeviceHeader" ColumnSpacing="12" Padding="12,8,24,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="248"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
            <Button Width="36" UseSystemFocusVisuals="False" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="19" Background="Transparent" BorderThickness="0" Foreground="White" Click="DeviceBack_Click"/>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDevice.Name, Mode=OneWay}" FontSize="26" FontFamily="/Assets/Fonts/BrownLogitechPan-Bold.otf#Brown Logitech Pan" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            <Grid x:Name="WindowDragRegion" Grid.Column="2" Background="Transparent"/>
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.PersistenceStatus, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsEditingOnboard, Mode=OneWay}" FontSize="10" Foreground="#999999" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="3" Margin="0,8,28,0" VerticalAlignment="Center"><ComboBox x:Name="ConfigurationPicker" AutomationProperties.AutomationId="configuration-picker" ItemsSource="{x:Bind ViewModel.Configurations, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedConfiguration, Mode=OneWay}" SelectionChanged="Configuration_Changed" HorizontalAlignment="Stretch" Background="#222426" Foreground="#DDDDDD" BorderThickness="0" CornerRadius="6" Height="32" MinHeight="32" IsEnabled="{x:Bind ViewModel.CanChangeDevice, Mode=OneWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ConfigurationChoice"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="{x:Bind Icon}" FontSize="15"/><TextBlock Text="{x:Bind Label}" FontSize="12"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
            <Button Grid.Column="4" Padding="0" MinWidth="0" Width="30" Margin="0,8,0,0" Content="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="19" Background="Transparent" Foreground="White" BorderThickness="0" ToolTipService.ToolTip="设备设置" Tag="4" Click="DeviceSection_Click"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid>
                <StackPanel Spacing="2" Margin="10,28,10,0">
                    <Button x:Name="PerformanceNav" Style="{StaticResource RailButtonStyle}" Tag="2" Click="DeviceSection_Click" ToolTipService.ToolTip="灵敏度（DPI）"><Canvas Width="26" Height="26"><Path Data="M 13,2 L 9,6 M 13,2 L 17,6 M 2,13 L 6,9 M 2,13 L 6,17 M 24,13 L 20,9 M 24,13 L 20,17 M 13,24 L 9,20 M 13,24 L 17,20" Stroke="#999999" StrokeThickness="1.8"/><Ellipse Width="4" Height="4" Fill="#999999" Canvas.Left="11" Canvas.Top="11"/></Canvas></Button>
                    <Button x:Name="AssignmentsNav" Style="{StaticResource RailButtonStyle}" Tag="0" Click="DeviceSection_Click" ToolTipService.ToolTip="按键分配" Background="#009EFF" Foreground="White"><Grid Width="24" Height="24"><Border BorderBrush="White" BorderThickness="2" CornerRadius="3"/><Path Data="M 7,12 L 17,12 M 12,7 L 12,17" Stroke="White" StrokeThickness="1.8"/></Grid></Button>
                    <Button x:Name="LightsyncNav" Visibility="{x:Bind ViewModel.HasRgbLighting, Mode=OneWay}" Style="{StaticResource RailButtonStyle}" Tag="3" Click="DeviceSection_Click" ToolTipService.ToolTip="LIGHTSYNC"><FontIcon Glyph="&#xE706;" FontSize="23"/></Button>
                </StackPanel>
                <Button Style="{StaticResource RailButtonStyle}" Tag="4" Click="DeviceSection_Click" VerticalAlignment="Bottom" Margin="7,0,7,18" ToolTipService.ToolTip="设备设置与板载内存"><FontIcon Glyph="&#xE713;" FontSize="22"/></Button>
            </Grid>
            <mouse:WorkspaceHost x:Name="WorkspaceTabs" Grid.Column="1" SelectionChanged="WorkspaceTabs_SelectionChanged" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">

            <mouse:WorkspaceSection Header="按键分配" Margin="0">
                <Grid ColumnSpacing="0" Padding="0,12,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#212224" CornerRadius="10" Padding="14,12,14,8">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="按键分配" FontSize="20" FontWeight="Normal" Foreground="White" Height="30"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Height="31">
                                <Button Width="24" x:Name="CommandsCategory" Tag="commands" Content="命令" Click="AssignmentCategory_Click" Style="{StaticResource CategoryButtonStyle}"/>
                                <Button Width="24" x:Name="KeysCategory" Tag="keys" Content="按键" Click="AssignmentCategory_Click" Style="{StaticResource CategoryButtonStyle}"/>
                                <Button Width="24" x:Name="ActionsCategory" Tag="actions" Content="操作" Click="AssignmentCategory_Click" Style="{StaticResource CategoryButtonStyle}"/>
                                <Button Width="12" x:Name="MacrosCategory" Tag="macros" Content="宏" Click="AssignmentCategory_Click" Style="{StaticResource CategoryButtonStyle}"/>
                                <Button Width="24" x:Name="SystemCategory" Tag="system" Content="系统" Click="AssignmentCategory_Click" Style="{StaticResource CategoryButtonStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Spacing="9"><TextBlock Text="{x:Bind ViewModel.AssignmentHint, Mode=OneWay}" FontSize="10" Foreground="#AAAAAA" TextWrapping="Wrap"/><Grid BorderBrush="#555555" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE721;" FontSize="10" Foreground="#DDDDDD" HorizontalAlignment="Left"/><TextBox Grid.Column="1" PlaceholderText="{x:Bind ViewModel.AssignmentSearchPlaceholder, Mode=OneWay}" Text="{x:Bind ViewModel.AssignmentSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Background="Transparent" BorderThickness="0" Padding="0,2" MinHeight="26"/></Grid></StackPanel>
                            <Grid Grid.Row="3" Visibility="{x:Bind ViewModel.IsMacroCategory, Mode=OneWay}" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><Button Content="创建新宏" Click="CreateMacro_Click" HorizontalAlignment="Stretch" Background="#3B3C3E" Foreground="White" BorderThickness="0" CornerRadius="0" Height="26" MinHeight="26" FontSize="12"/><Button Grid.Column="1" Content="LUA 脚本" AutomationProperties.AutomationId="lua-open" Click="LuaEditor_Click" Background="#3B3C3E" BorderThickness="0" CornerRadius="0" Height="26" MinHeight="26" FontSize="12" HorizontalAlignment="Stretch"/></Grid>
                            <ListView Grid.Row="4" ItemsSource="{x:Bind ViewModel.AssignmentItems, Mode=OneWay}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Assignment_ItemClick" CanDragItems="True" DragItemsStarting="Assignment_DragItemsStarting" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="32"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate><DataTemplate x:DataType="vm:AssignmentItem"><Grid Padding="0,6" BorderBrush="#353638" BorderThickness="0,0,0,1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                    <Border Background="{x:Bind ChipBrush}" Width="16" Height="16"><TextBlock Text="{x:Bind Chip}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="12" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{x:Bind AssignedTo}" FontSize="11" Foreground="#CCCCCC" HorizontalAlignment="Right"/>
                                </Grid></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1">
                        <mouse:MouseMapView DeviceModel="{x:Bind ViewModel.DeviceModel, Mode=OneWay}" Bindings="{x:Bind ViewModel.VisibleBindings, Mode=OneWay}" SelectedButton="{x:Bind ViewModel.SelectedButton, Mode=OneWay}" IsSideView="{x:Bind ViewModel.IsSideView, Mode=OneWay}" ButtonSelected="MouseMap_ButtonSelected" ResetRequested="MouseMap_ResetRequested" DisableRequested="MouseMap_DisableRequested" EditMacroRequested="MouseMap_EditMacroRequested" AssignmentDropped="MouseMap_AssignmentDropped"/>
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="24" Margin="0,0,0,66">
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center"><ToggleButton Content="视图 1" Tag="front" Style="{StaticResource GHubViewButton}" IsChecked="{x:Bind ViewModel.IsFrontView, Mode=OneWay}" Click="MouseView_Click"/><ToggleButton Content="视图 2" Visibility="{x:Bind ViewModel.HasModelSideView, Mode=OneWay}" Tag="side" Style="{StaticResource GHubViewButton}" IsChecked="{x:Bind ViewModel.IsSideView, Mode=OneWay}" Click="MouseView_Click"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"><TextBlock Text="默认模式" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/><ToggleButton Style="{StaticResource GHubShiftToggle}" IsChecked="{x:Bind ViewModel.ShowGShift, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.HasGShift, Mode=OneWay}"/><TextBlock Text="G-SHIFT 模式" FontSize="11" FontWeight="SemiBold" Foreground="#777777" VerticalAlignment="Center"/></StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </mouse:WorkspaceSection>
            <mouse:WorkspaceSection Header="宏"><Grid/></mouse:WorkspaceSection>
            <mouse:WorkspaceSection Header="灵敏度（DPI）"><mouse:DpiProfileView BoardRequested="BoardRequested" HeroRequested="HeroRequested"/></mouse:WorkspaceSection>
            <mouse:WorkspaceSection Header="LIGHTSYNC">
                <Grid Padding="0,12,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#212224" CornerRadius="10" Padding="14,12,14,12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="20">
                        <TextBlock Text="LIGHTSYNC" FontSize="21" FontWeight="SemiBold"/>
                        <Button Content="☼  WINDOWS 设置  ↗" FontSize="12" Padding="6,0" Background="Transparent" BorderThickness="0" Foreground="#888888" Click="WindowsLighting_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="PresetLightTab" Content="预设" Tag="Preset" Style="{StaticResource CategoryButtonStyle}" Width="24" Click="LightsyncMode_Click"/><Button x:Name="FreestyleLightTab" Content="自定义" Tag="Freestyle" Style="{StaticResource CategoryButtonStyle}" Width="36" Click="LightsyncMode_Click"/><Button x:Name="AnimationLightTab" Content="动画" Tag="Animation" Style="{StaticResource CategoryButtonStyle}" Width="24" Click="LightsyncMode_Click"/></StackPanel>
                        <ComboBox Visibility="{x:Bind ViewModel.IsPreset, Mode=OneWay}" Header="效果" ItemsSource="{x:Bind ViewModel.AvailableLightsyncEffects, Mode=OneWay}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.SelectedLightsyncEffect, Mode=OneWay}" SelectionChanged="LightsyncEffect_SelectionChanged" Background="Transparent" BorderThickness="0" Padding="4,0" FontSize="12" HorizontalAlignment="Stretch"/>
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.UsesPrimaryColor, Mode=OneWay}"><TextBlock Text="颜色" FontSize="12" Foreground="#AAAAAA"/><ColorPicker x:Name="LightsyncColorPicker" Color="#00B8D9" ColorChanged="LightsyncColor_Changed" IsAlphaEnabled="False" IsMoreButtonVisible="False" IsColorSliderVisible="False" IsColorChannelTextInputVisible="False" IsHexInputVisible="False" MaxHeight="180" HorizontalAlignment="Stretch"/><mouse:CommitTextBox AutomationProperties.AutomationId="lightsync-color-input" Value="{x:Bind ViewModel.LightsyncColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Validating="ColorInput_Validating" Background="Transparent" BorderBrush="#555555" BorderThickness="0,0,0,1" FontSize="12"/></StackPanel>
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.UsesSpeed, Mode=OneWay}"><TextBlock Text="速度（毫秒）" FontSize="12" Foreground="#AAAAAA"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions><mouse:PrecisionSlider Minimum="100" Maximum="12000" StepFrequency="50" Value="{x:Bind ViewModel.LightsyncPeriod, Mode=OneWay}" Tag="Period" UserValueChanged="LightsyncSlider_UserChanged"/><NumberBox Grid.Column="1" Minimum="100" Maximum="65535" Value="{x:Bind ViewModel.LightsyncPeriod, Mode=OneWay}" ValueChanged="LightsyncPeriodNumber_Changed" SpinButtonPlacementMode="Hidden" FontSize="11" BorderThickness="0" Background="Transparent" Padding="0"/></Grid></StackPanel>
                        <StackPanel Spacing="4"><TextBlock Text="亮度" FontSize="12" Foreground="#AAAAAA"/><mouse:PrecisionSlider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.LightsyncBrightness, Mode=OneWay}" Tag="Brightness" UserValueChanged="LightsyncSlider_UserChanged"/></StackPanel>
                        <ToggleSwitch Visibility="{x:Bind ViewModel.UsesDirection, Mode=OneWay}" OffContent="正向" OnContent="反向" IsOn="{x:Bind ViewModel.LightsyncReverse, Mode=TwoWay}" FontSize="12"/>
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsFreestyle, Mode=OneWay}"><Button Content="应用颜色" Command="{x:Bind ViewModel.PaintSelectedZonesCommand}" HorizontalAlignment="Stretch"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="全选" Command="{x:Bind ViewModel.SelectAllZonesCommand}"/><Button Content="取消选择" Command="{x:Bind ViewModel.ClearZoneSelectionCommand}"/></StackPanel></StackPanel>
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsAnimation, Mode=OneWay}"><TextBlock Text="效果" Foreground="#999999" FontSize="12"/><ComboBox AutomationProperties.AutomationId="animation-preset-picker" ItemsSource="{x:Bind ViewModel.AnimationPresets, Mode=OneWay}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.SelectedAnimationPreset, Mode=TwoWay}" SelectionChanged="AnimationPreset_Changed" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0"/><StackPanel Orientation="Horizontal" Spacing="12"><Button AutomationProperties.AutomationId="animation-new" Content="+" FontSize="24" Width="36" ToolTipService.ToolTip="创建新动画" Background="Transparent" BorderThickness="0" Click="NewAnimation_Click"/><Button AutomationProperties.AutomationId="animation-edit" Content="&#xE70F;" FontFamily="Segoe Fluent Icons" ToolTipService.ToolTip="编辑动画" Background="Transparent" BorderThickness="0" Click="EditAnimation_Click"/><Button Content="&#xE74D;" FontFamily="Segoe Fluent Icons" ToolTipService.ToolTip="删除自定义动画" Background="Transparent" BorderThickness="0" Click="DeleteAnimation_Click"/></StackPanel><HyperlinkButton Content="编辑动画" Padding="0" FontSize="12" Click="EditAnimation_Click"/></StackPanel>
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsScreenSampler, Mode=OneWay}"><ComboBox Header="显示器" ItemsSource="{x:Bind ViewModel.Monitors, Mode=OneWay}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.SelectedMonitor, Mode=TwoWay}" HorizontalAlignment="Stretch"/><TextBlock Text="拖动采样区域，调整每个灯区对应的画面范围。" FontSize="12" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsAudioVisualizer, Mode=OneWay}"><TextBlock Text="系统默认音频输出" FontSize="12"/><TextBox Header="背景颜色" Text="{x:Bind ViewModel.LightsyncBackground, Mode=TwoWay}"/><TextBlock Text="音频增益" FontSize="12"/><mouse:PrecisionSlider Minimum="0.1" Maximum="20" StepFrequency="0.1" Value="{x:Bind ViewModel.AudioGain, Mode=OneWay}" Tag="Gain" UserValueChanged="LightsyncSlider_UserChanged"/></StackPanel>
                        <Expander Header="设备与板载" FontSize="12" HorizontalAlignment="Stretch"><StackPanel Spacing="10"><Button Content="应用到鼠标" Command="{x:Bind ViewModel.ApplyLightsyncCommand}" IsEnabled="{x:Bind ViewModel.HasSnapshot, Mode=OneWay}"/><Button Content="停止软件灯效" Command="{x:Bind ViewModel.StopLightsyncCommand}" IsEnabled="{x:Bind ViewModel.LightsyncRunning, Mode=OneWay}"/><Button Content="加入板载草稿" Command="{x:Bind ViewModel.StageLightsyncCommand}" IsEnabled="{x:Bind ViewModel.CanEditLighting, Mode=OneWay}"/><Button Content="打开板载配置" Click="OpenBoard_Click"/><ToggleSwitch OffContent="预览暂停" OnContent="播放预览" IsOn="{x:Bind ViewModel.PlayLightsyncPreview, Mode=TwoWay}"/><TextBlock Text="{x:Bind ViewModel.LightsyncStatus, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.LightsyncStorageNote, Mode=OneWay}" FontSize="11" Foreground="#999999" TextWrapping="Wrap"/></StackPanel></Expander>
                    </StackPanel></ScrollViewer></Border>
                    <Grid Grid.Column="1"><mouse:LightsyncMapView DeviceModel="{x:Bind ViewModel.DeviceModel, Mode=OneWay}" Zones="{x:Bind ViewModel.LedZones, Mode=OneWay}" ShowSelectors="{x:Bind ViewModel.ShowLedSelectors, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsNotScreenSampler, Mode=OneWay}"/>
                        <StackPanel Visibility="{x:Bind ViewModel.IsScreenSampler, Mode=OneWay}" MaxWidth="1050" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center"><mouse:ScreenRegionView Height="460" Regions="{x:Bind ViewModel.SampleRegions}" SelectedRegion="{x:Bind ViewModel.SelectedSampleRegion, Mode=OneWay}" RegionSelected="ScreenRegion_Selected"/><ComboBox ItemsSource="{x:Bind ViewModel.SampleRegions, Mode=OneWay}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.SelectedSampleRegion, Mode=TwoWay}"/><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Header="X（%）" Text="{Binding SelectedSampleRegion.X, Mode=TwoWay}"/><TextBox Grid.Column="1" Header="Y（%）" Text="{Binding SelectedSampleRegion.Y, Mode=TwoWay}"/><TextBox Grid.Column="2" Header="宽（%）" Text="{Binding SelectedSampleRegion.Width, Mode=TwoWay}"/><TextBox Grid.Column="3" Header="高（%）" Text="{Binding SelectedSampleRegion.Height, Mode=TwoWay}"/></Grid></StackPanel>
                    </Grid>
                </Grid>
            </mouse:WorkspaceSection>
            <mouse:WorkspaceSection Header="设备与备份"><Grid/></mouse:WorkspaceSection>
            </mouse:WorkspaceHost>
        </Grid>
        <Grid x:Name="SettingsOverlay" Grid.RowSpan="2" Canvas.ZIndex="9" Visibility="Collapsed" Background="Black">
            <Button Content="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="19" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,26,0,0" Width="36" Click="SettingsBack_Click"/>
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Margin="64,96,64,24"><StackPanel MaxWidth="1100" Spacing="42">
                <Grid Height="240"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="12"><TextBlock Text="电池电量" FontSize="12" Foreground="#999999"/><TextBlock Text="{x:Bind ViewModel.BatteryText, Mode=OneWay}" FontSize="14"/><TextBlock Text="{x:Bind ViewModel.ChargingText, Mode=OneWay}" FontSize="12" Foreground="#AAAAAA"/><TextBlock Text="连接" FontSize="12" Foreground="#999999" Margin="0,12,0,0"/><TextBlock Text="{x:Bind ViewModel.DeviceConnectionText, Mode=OneWay}" FontSize="12"/><TextBlock Text="{x:Bind ViewModel.ModeSummary, Mode=OneWay}" FontSize="12" Foreground="#999999" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Grid.ColumnSpan="3" HorizontalAlignment="Center" Spacing="2" IsHitTestVisible="False"><TextBlock Text="{x:Bind ViewModel.SelectedDevice.Name, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="#555555" HorizontalAlignment="Center"/><Image Source="{x:Bind ViewModel.DeviceImageSource, Mode=OneWay}" Height="144" Width="100" Stretch="Uniform"/></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="12" HorizontalAlignment="Right"><TextBlock Text="固件版本" FontSize="12" Foreground="#999999" HorizontalAlignment="Right"/><TextBlock Text="{x:Bind ViewModel.FirmwareText, Mode=OneWay}" FontSize="12"/><TextBlock Text="{x:Bind ViewModel.DeviceSummary, Mode=OneWay}" FontSize="11" Foreground="#999999" MaxWidth="260" TextWrapping="Wrap" HorizontalAlignment="Right"/><HyperlinkButton Content="读取设备状态" Command="{x:Bind ViewModel.ReadCommand}" FontSize="12" HorizontalAlignment="Right" Padding="0"/></StackPanel>
                </Grid>
                <Grid ColumnSpacing="132"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="300"/><ColumnDefinition Width="236"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="20"><StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasStartupEffect, Mode=OneWay}"><TextBlock Text="启动效果" FontSize="12" Foreground="#999999"/><CheckBox Content="启用启动效果" FontSize="12" IsChecked="{x:Bind ViewModel.StartupEffectEnabled, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"/></StackPanel><StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasLightforce, Mode=OneWay}"><TextBlock Text="LIGHTFORCE" FontSize="12" Foreground="#999999"/><ComboBox AutomationProperties.AutomationId="lightforce-mode" ItemsSource="{x:Bind ViewModel.LightforceModes, Mode=OneWay}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.SelectedLightforceMode, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" Background="Transparent" BorderThickness="0" FontSize="12" HorizontalAlignment="Stretch"/><TextBlock Text="混合模式可延长电池续航。仅光学模式保持光学检测。" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/></StackPanel><HyperlinkButton Visibility="{x:Bind ViewModel.HasHeroCalibration, Mode=OneWay}" Content="HERO 传感器校准" Click="HeroSettings_Click" Padding="0" FontSize="12"/></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="14" Visibility="{x:Bind ViewModel.HasRgbLighting, Mode=OneWay}"><TextBlock Text="闲置灯光" FontSize="12" Foreground="#999999"/><Button Content="选择灯效  ⌄" Tag="3" Click="DeviceSection_Click" FontSize="12" Background="Transparent" BorderThickness="0" Padding="0"/><mouse:CommitTextBox Header="启动于（秒）" AutomationProperties.AutomationId="power-save-input" Value="{x:Bind ViewModel.PowerSaveSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Validating="TimeoutInput_Validating" FontSize="12" Background="Transparent" BorderThickness="0,0,0,1"/><mouse:CommitTextBox Header="延迟全灯关闭（秒）" AutomationProperties.AutomationId="power-off-input" Value="{x:Bind ViewModel.PowerOffSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Validating="TimeoutInput_Validating" FontSize="12" Background="Transparent" BorderThickness="0,0,0,1"/><TextBlock Text="选择板载配置后，修改会自动写入。" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="14"><Grid><TextBlock Text="板载内存模式" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center"/><Button Content="{x:Bind ViewModel.OnboardModeText, Mode=OneWay}" HorizontalAlignment="Right" Padding="8,0" Height="22" MinHeight="0" CornerRadius="12" FontSize="11" BorderBrush="#666666" Background="Black" IsEnabled="{x:Bind ViewModel.CanChangeMode, Mode=OneWay}" Click="OnboardModeButton_Click"/></Grid>
                        <ListView IsEnabled="{x:Bind ViewModel.CanChangeDevice, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="BoardProfile_Click"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="28"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="board:MouseProfile"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind SlotLabel}" FontSize="12" Foreground="#777777"/><TextBlock Grid.Column="1" Text="{x:Bind GHubDisplayName}" FontSize="12" Foreground="#009EFF" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                        <Button Content="预览并写入" Visibility="{x:Bind ViewModel.IsEditingSoftware, Mode=OneWay}" Click="Write_Click" IsEnabled="{x:Bind ViewModel.CanWrite, Mode=OneWay}" FontSize="12" HorizontalAlignment="Stretch" Background="#009EFF" Foreground="Black" BorderThickness="0" CornerRadius="0"/>
                        <Expander Header="侧键直达板载配置" FontSize="12" HorizontalAlignment="Stretch"><StackPanel Spacing="10"><TextBlock Text="双配置模式：两个侧键分别指向两个槽位。仅启用所选两个槽位，其他槽位内容保留；解除时恢复原按键与启用状态。" FontSize="12" TextWrapping="Wrap" Foreground="#AAAAAA"/><ComboBox Header="第一个目标槽位" ItemsSource="{x:Bind ViewModel.PairProfileChoices}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.PairFirstProfile, Mode=TwoWay}" HorizontalAlignment="Stretch"/><ComboBox Header="直达第一个槽位的按键" ItemsSource="{x:Bind ViewModel.PairButtonChoices}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.PairFirstButton, Mode=TwoWay}" HorizontalAlignment="Stretch"/><ComboBox Header="第二个目标槽位" ItemsSource="{x:Bind ViewModel.PairProfileChoices}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.PairSecondProfile, Mode=TwoWay}" HorizontalAlignment="Stretch"/><ComboBox Header="直达第二个槽位的按键" ItemsSource="{x:Bind ViewModel.PairButtonChoices}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.PairSecondButton, Mode=TwoWay}" HorizontalAlignment="Stretch"/><CheckBox Content="同时设置 G-SHIFT 层" IsChecked="{x:Bind ViewModel.PairIncludeGShift, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.HasGShift, Mode=OneWay}"/><Button AutomationProperties.AutomationId="profile-pair-apply" Content="写入双配置直达" Command="{x:Bind ViewModel.ApplyProfilePairCommand}" IsEnabled="{x:Bind ViewModel.CanConfigureProfilePair, Mode=OneWay}" HorizontalAlignment="Stretch"/><Button AutomationProperties.AutomationId="profile-pair-remove" Content="解除直达并恢复原设置" Command="{x:Bind ViewModel.RemoveProfilePairCommand}" IsEnabled="{x:Bind ViewModel.CanRemoveProfilePair, Mode=OneWay}" HorizontalAlignment="Stretch"/><TextBlock Text="{x:Bind ViewModel.PairStatus, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Expander>
                        <Expander Header="板载写入与备份" FontSize="12" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><mouse:CommitTextBox Header="配置名称" AutomationProperties.AutomationId="profile-name-input" Value="{x:Bind ViewModel.ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="12"/><CheckBox IsEnabled="{x:Bind ViewModel.CanChangeProfileEnabled, Mode=OneWay}" Content="启用此储存位" IsChecked="{x:Bind ViewModel.ProfileEnabled, Mode=TwoWay}"/><CheckBox Content="允许格式 10 实验性写入" IsChecked="{x:Bind ViewModel.AllowExperimental, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsExperimental, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.ModelSupportNote, Mode=OneWay}" FontSize="11" Foreground="#999999" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.CapabilityNote, Mode=OneWay}" FontSize="11" Foreground="#999999" TextWrapping="Wrap"/><Button Content="导出完整备份" Click="ExportBackup_Click" IsEnabled="{x:Bind ViewModel.HasSnapshot, Mode=OneWay}" FontSize="12"/><Button Content="从备份恢复…" Click="RestoreBackup_Click" IsEnabled="{x:Bind ViewModel.CanWrite, Mode=OneWay}" FontSize="12"/><Button Content="打开自动备份目录" Click="OpenBackups_Click" FontSize="12"/><TextBlock Text="{x:Bind ViewModel.LastBackupPath, Mode=OneWay}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Expander>
                    </StackPanel>
                </Grid>
                <Expander Header="设备诊断与软件配置" FontSize="12" HorizontalAlignment="Stretch"><StackPanel Spacing="12"><ComboBox ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}" DisplayMemberPath="DisplayName" SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=OneWay}" SelectionChanged="DevicePicker_SelectionChanged" IsEnabled="{x:Bind ViewModel.CanChangeDevice, Mode=OneWay}" FontSize="12"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="扫描设备" Command="{x:Bind ViewModel.ScanCommand}"/><Button Content="重新读取" Command="{x:Bind ViewModel.ReadCommand}"/><Button Content="保存软件配置" Command="{x:Bind ViewModel.SaveSoftwareSettingsCommand}"/><Button Content="载入软件配置" Command="{x:Bind ViewModel.LoadSoftwareSettingsCommand}"/></StackPanel></StackPanel></Expander>
                <StackPanel Spacing="12"><TextBlock Text="日志与诊断" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ViewModel.DiagnosticsStatus, Mode=OneWay}" FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="导出诊断包…" AutomationProperties.AutomationId="diagnostics-export" Click="ExportDiagnostics_Click" IsEnabled="{x:Bind ViewModel.CanExportDiagnostics, Mode=OneWay}"/><Button Content="重试板载保存" AutomationProperties.AutomationId="diagnostics-retry-save" Click="RetrySave_Click" IsEnabled="{x:Bind ViewModel.CanRetryOnboardSave, Mode=OneWay}"/></StackPanel><TextBlock Text="包含设备信息、板载原始数据与校验、宏及 Lua 源码、编辑内容、HID 通信、完整异常和历史日志。导出过程不会写入鼠标。" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/></StackPanel>
                <Expander Header="操作记录" FontSize="12" HorizontalAlignment="Stretch"><ItemsControl ItemsSource="{x:Bind ViewModel.Activity, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
            </StackPanel></ScrollViewer>
        </Grid>
        <Grid x:Name="MacroOverlay" Grid.RowSpan="2" Canvas.ZIndex="10" Visibility="Collapsed"><mouse:MacroEditorView x:Name="MacroEditorHost" Closed="MacroEditor_Closed" RecordRequested="MacroEditor_RecordRequested" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"/></Grid>
        <Grid x:Name="AnimationOverlay" Grid.RowSpan="2" Canvas.ZIndex="11" Visibility="Collapsed"><mouse:AnimationEditorView x:Name="AnimationEditorHost" Closed="AnimationEditor_Closed"/></Grid>
        <Grid x:Name="HeroOverlay" Grid.RowSpan="2" Canvas.ZIndex="12" Visibility="Collapsed"><mouse:HeroCalibrationView x:Name="HeroEditorHost" Closed="HeroEditor_Closed"/></Grid>
        <Grid x:Name="LuaOverlay" Grid.RowSpan="2" Canvas.ZIndex="13" Visibility="Collapsed"><mouse:LuaEditorView x:Name="LuaEditorHost" Closed="LuaEditor_Closed"/></Grid>
        <InfoBar x:Name="StatusBar" Grid.Row="1" Canvas.ZIndex="8" VerticalAlignment="Bottom" Margin="324,0,24,8" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="True" Severity="Error" Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}" Message="{x:Bind ViewModel.Status, Mode=OneWay}"><InfoBar.ActionButton><Button Content="导出诊断包…" AutomationProperties.AutomationId="error-export-diagnostics" Click="ExportDiagnostics_Click" IsEnabled="{x:Bind ViewModel.CanExportDiagnostics, Mode=OneWay}"/></InfoBar.ActionButton></InfoBar>
    </Grid></Viewbox></Grid>
</Page>
