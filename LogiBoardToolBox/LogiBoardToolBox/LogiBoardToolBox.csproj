<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>LogiBoardToolBox</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <Platform Condition="'$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.String]::Copy('$(Platform)').ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <Version>1.1.11</Version>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Views\LogViewPage.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Assets\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Using Include="LogiBoardToolBox.ViewModels" />
    <Using Include="LogiBoardToolBox.Views" />
    <Using Include="Microsoft.UI.Xaml" />
    <Using Include="Microsoft.UI.Xaml.Controls" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="XFEExtension.NetCore.AutoConfig" Version="4.1.2" />
    <PackageReference Include="XFEExtension.NetCore.AutoPath" Version="2.0.0" />
    <PackageReference Include="XFEExtension.NetCore.XFEConsole" Version="2.6.0" />
    <PackageReference Include="XFEExtension.NetCore.WinUIHelper" Version="2.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true' Or '$(PublishProfile)' == 'win-x64-aot'">
    <!-- Diagnostic payloads include anonymous records from both assemblies. -->
    <TrimmerRootAssembly Include="LogiBoardToolBox" />
    <TrimmerRootAssembly Include="LogiBoardToolBox.Core" />
    <!-- MoonSharp discovers the built-in sandbox modules by reflection. -->
    <TrimmerRootAssembly Include="MoonSharp.Interpreter" />
    <TrimmerRootDescriptor Include="Properties\NativeAotRoots.xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LogiBoardToolBox.Core\LogiBoardToolBox.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Assets\Resources\" />
    <Folder Include="Models\" />
  </ItemGroup>
  <ItemGroup>
    <Page Update="Views\LogViewPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Styles\Colors.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Update="Styles\ConverterResources.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <Page Update="Views\MainPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
