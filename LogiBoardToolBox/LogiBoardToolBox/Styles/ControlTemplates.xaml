<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:LogiBoardToolBox.Controls">
    <Style TargetType="controls:PrecisionSlider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PrecisionSlider">
                    <Grid x:Name="TrackArea" Height="28" Background="Transparent">
                        <Rectangle Fill="#35383B" Height="3" Margin="6,0" RadiusX="1.5" RadiusY="1.5"/>
                        <Rectangle x:Name="ValueFill" Fill="#009EFF" Height="3" HorizontalAlignment="Left" Margin="6,0,0,0" RadiusX="1.5" RadiusY="1.5"/>
                        <Ellipse x:Name="Thumb" Fill="White" Width="12" Height="12" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
